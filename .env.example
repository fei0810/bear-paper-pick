# 本地配置模板。复制为 .env 后填写；也可用 BEAR_PAPER_PICK_ENV_FILE 指向仓库外文件。
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# 主工作流 screen 固定 review。独立 jev_rank 对照实验可显式使用 shadow。
JEV_MODE=review
# 实际外发还包括研究画像正负轴与逻辑形，详见 docs/PRIVACY.md。
JEV_EXTERNAL_SEND_SCOPE=public_metadata_and_english_abstract_only
JEV_MIN_CONFIDENCE=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
